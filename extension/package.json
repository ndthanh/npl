{
  "name": "nopilot",
  "displayName": "Nopilot",
  "description": "Teams Copilot beside your editor, through a local Frida bridge.",
  "version": "0.7.8",
  "publisher": "ndthanh",
  "license": "MIT",
  "engines": {
    "vscode": "^1.108.0"
  },
  "categories": [
    "Other"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/ndthanh/npl.git"
  },
  "main": "./dist/extension.js",
  "extensionKind": [
    "ui"
  ],
  "activationEvents": [
    "onView:nopilot.chat",
    "onStartupFinished"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Chat transport, workspace context, web tools and execution require a trusted local workspace."
    },
    "virtualWorkspaces": false
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "nopilot",
          "title": "Nopilot",
          "icon": "media/nopilot.svg"
        }
      ]
    },
    "views": {
      "nopilot": [
        {
          "type": "webview",
          "id": "nopilot.chat",
          "name": "Chat"
        }
      ]
    },
    "commands": [
      {
        "command": "nopilot.migration",
        "title": "Nopilot: Open Migration Workbench"
      },
      {
        "command": "nopilot.open",
        "title": "Nopilot: Open Chat"
      },
      {
        "command": "nopilot.expand",
        "title": "Nopilot: Open Chat in Editor",
        "icon": "$(screen-full)"
      },
      {
        "command": "nopilot.history",
        "title": "Nopilot: Conversation History",
        "icon": "$(history)"
      },
      {
        "command": "nopilot.new",
        "title": "Nopilot: New Conversation",
        "icon": "$(add)"
      },
      {
        "command": "nopilot.addSelection",
        "title": "Nopilot: Add Selection to Chat"
      },
      {
        "command": "nopilot.connect",
        "title": "Nopilot: Connect to Teams"
      },
      {
        "command": "nopilot.gatewayInfo",
        "title": "Nopilot: Copy Local Agent Gateway Connection"
      },
      {
        "command": "nopilot.modelKey",
        "title": "Nopilot: Set Small Model API Key"
      },
      {
        "command": "nopilot.help",
        "title": "Nopilot: Open Guide"
      },
      {
        "command": "nopilot.configureVoice",
        "title": "Nopilot: Configure Local Voice Model"
      },
      {
        "command": "nopilot.checkRuntime",
        "title": "Nopilot: Check Runtime"
      },
      {
        "command": "nopilot.generateTeamsManifest",
        "title": "Nopilot: Tạo manifest cho bản Teams này"
      },
      {
        "command": "nopilot.repairRuntime",
        "title": "Nopilot: Repair Bridge Dependencies"
      },
      {
        "command": "nopilot.initIgnore",
        "title": "Nopilot: Create or Open .nopilotignore"
      },
      {
        "command": "nopilot.setup",
        "title": "Nopilot: Set Up Python Environment"
      },
      {
        "command": "nopilot.database",
        "title": "Nopilot: Open Data Explorer"
      },
      {
        "command": "nopilot.moveSidebar",
        "title": "Nopilot: Move Chat to Sidebar…",
        "icon": "$(layout-sidebar-right)"
      },
      {
        "command": "nopilot.localModel",
        "title": "Nopilot: Configure Local GGUF Model"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "nopilot.addSelection",
          "when": "editorHasSelection",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "Nopilot",
      "properties": {
        "nopilot.pythonPath": {
          "type": "string",
          "default": "python",
          "description": "Absolute Python executable with bridge requirements installed. No PowerShell is used."
        },
        "nopilot.responseTimeout": {
          "type": "number",
          "default": 300,
          "minimum": 30,
          "maximum": 900
        },
        "nopilot.gateway.enabled": {
          "type": "boolean",
          "default": false,
          "description": "Authenticated loopback agent API; token is stored in SecretStorage."
        },
        "nopilot.gateway.port": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "maximum": 65535
        },
        "nopilot.smallModel.endpoint": {
          "type": "string",
          "default": "",
          "description": "Optional OpenAI-compatible chat completions endpoint. Invoked only with /assist."
        },
        "nopilot.smallModel.model": {
          "type": "string",
          "default": ""
        },
        "nopilot.voice.modelPath": {
          "type": "string",
          "default": "",
          "description": "Local faster-whisper CTranslate2 model folder. No automatic model download or cloud transcription."
        },
        "nopilot.voice.pythonPath": {
          "type": "string",
          "default": "",
          "description": "Optional Python runtime for local speech; blank uses nopilot.pythonPath."
        },
        "nopilot.voice.language": {
          "type": "string",
          "default": "vi",
          "description": "Whisper language code, e.g. vi, en or auto."
        },
        "nopilot.voice.device": {
          "type": "number",
          "default": -1,
          "description": "PortAudio input device ID; -1 uses the default microphone."
        },
        "nopilot.copilotModel": {
          "type": "string",
          "default": "GPT-5.6 Sol Think deeper",
          "description": "Exact Copilot menu label. Verified before uploading/sending. Empty disables model selection."
        },
        "nopilot.localModel.pythonPath": {
          "type": "string",
          "default": "",
          "description": "Dedicated Python executable with llama-cpp-python installed.",
          "scope": "machine",
          "restricted": true
        },
        "nopilot.localModel.modelPath": {
          "type": "string",
          "default": "",
          "description": "Absolute local GGUF path. Never downloaded or loaded automatically.",
          "scope": "machine",
          "restricted": true
        },
        "nopilot.localModel.contextSize": {
          "type": "number",
          "default": 8192,
          "description": "Local context window in tokens.",
          "scope": "machine",
          "restricted": true,
          "minimum": 2048,
          "maximum": 32768
        },
        "nopilot.localModel.threads": {
          "type": "number",
          "default": 4,
          "description": "CPU inference threads.",
          "scope": "machine",
          "restricted": true,
          "minimum": 1,
          "maximum": 64
        },
        "nopilot.localModel.gpuLayers": {
          "type": "number",
          "default": 0,
          "description": "0 uses CPU. GPU requires a compatible llama-cpp-python build.",
          "scope": "machine",
          "restricted": true,
          "minimum": -1,
          "maximum": 256
        },
        "nopilot.localModel.maxSteps": {
          "type": "number",
          "default": 10,
          "description": "Maximum read/inference steps per explicit local task. No automatic continuation.",
          "scope": "machine",
          "restricted": true,
          "minimum": 1,
          "maximum": 10
        }
      }
    }
  },
  "scripts": {
    "build": "node build.mjs",
    "check": "tsc --noEmit",
    "test": "node --test test/*.test.cjs",
    "package": "npm run build && vsce package --no-dependencies"
  },
  "dependencies": {
    "@ag-ui/core": "^1.0.3",
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/highlight": "^1.2.5",
    "@vscode/codicons": "^0.0.46-24",
    "codemirror": "^6.0.2",
    "diff": "^8.0.4",
    "highlight.js": "^11.11.1",
    "ignore": "^7.0.5",
    "markdown-it": "^14.1.0",
    "qrcode": "^1.5.4",
    "yazl": "^3.3.1",
    "zod": "^4.6.6"
  },
  "overrides": {
    "@azure/msal-node": "^7.1.0"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^22.0.0",
    "@types/qrcode": "^1.5.6",
    "@types/vscode": "^1.95.0",
    "@types/yazl": "^3.3.0",
    "@vscode/vsce": "^3.6.0",
    "esbuild": "^0.25.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.10",
    "typescript": "^5.9.0"
  }
}
